FROM python:3.12-alpine

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY pyproject.toml ./
COPY afterpush_api ./afterpush_api
COPY afterpush_engine ./afterpush_engine
COPY afterpush_cli ./afterpush_cli

RUN pip install --no-cache-dir .

RUN adduser -D -u 10001 afterpush
USER 10001

EXPOSE 8000

CMD ["uvicorn", "afterpush_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
