FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/tmp

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml ./
COPY afterpush_api ./afterpush_api
COPY afterpush_engine ./afterpush_engine
COPY afterpush_cli ./afterpush_cli

RUN pip install --no-cache-dir .

RUN useradd --create-home --uid 10001 afterpush
USER 10001

CMD ["python", "-m", "afterpush_api.workers.deployment_runtime_reconciliation", "--in-cluster"]
