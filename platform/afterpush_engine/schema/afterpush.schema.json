{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://afterpush.dev/schema/v1/application.json",
  "title": "AfterPush Application",
  "description": "Developer-facing configuration for an application deployed through AfterPush.",
  "type": "object",
  "additionalProperties": false,

  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],

  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "afterpush.dev/v1"
    },

    "kind": {
      "type": "string",
      "const": "Application"
    },

    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        }
      }
    },

    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image",
        "port",
        "health"
      ],
      "properties": {
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "tag"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1
            }
          }
        },

        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },

        "health": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^/"
            }
          }
        },

        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "host": {
              "type": "string",
              "minLength": 1
            }
          }
        },

        "scaling": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "maxReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "targetCPUUtilization": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },

        "monitoring": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}